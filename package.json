{
  "name": "hackohio2026",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix apps/web install && node scripts/api-python.mjs -m pip install -r requirements-dev.txt",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/api-python.mjs -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix apps/web run dev",
    "test": "npm run test:api && npm --prefix apps/web test",
    "test:api": "node scripts/api-python.mjs -m pytest -q",
    "seed:generate": "node scripts/api-python.mjs -m seedgen"
  },
  "devDependencies": {
    "concurrently": "9.2.5"
  }
}
