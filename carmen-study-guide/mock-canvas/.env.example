# Copy to .env and fill in. Never commit .env.

# Supabase (shared team project). The URL and publishable key are public.
SUPABASE_URL=https://besxavsdjolmxbdcbclw.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tV7EDWWaIA0nlhAEFvxJIg_swvLnb_K
# Server-only secret: bypasses row-level security. Get it privately from the database owner.
# Either name works: the legacy service_role key, or the newer secret key (sb_secret_...) as SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Optional: export from / snapshot a real Canvas course (ingest.py, snapshot.py)
# CANVAS_BASE_URL=https://osu.instructure.com
# CANVAS_TOKEN=
# Secret used to derive stable pseudonymous student IDs in exports. Set once, then keep it stable.
# ANON_SALT=

# Study tutor (tutor/). Either Claude (paid, best quality) or a local Ollama (free):
# TUTOR_LLM=ollama            # unset = Claude when ANTHROPIC_API_KEY is set, otherwise Ollama
# TUTOR_LLM=bedrock           # AWS credits: Amazon Nova via Bedrock (needs the AWS_* lines below)
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # temporary SSO credentials expire; paste fresh ones
# BEDROCK_TUTOR_MODEL=us.amazon.nova-pro-v1:0      # a Claude id (us.anthropic....) uses the Claude adapter
# BEDROCK_CHECK_MODEL=us.amazon.nova-2-lite-v1:0
ANTHROPIC_API_KEY=REPLACE_ME
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_TUTOR_MODEL=qwen2.5:7b
# OLLAMA_CHECK_MODEL=qwen2.5:3b

# Temporary demo mode: the tutor page signs in as the demo student automatically (a real Supabase sign-in done
# by the server). Needs DEMO_ACCOUNT_PASSWORD (shared privately). Remove both lines to require a normal sign-in.
# TUTOR_DEMO_AUTO_SIGNIN=1
# DEMO_ACCOUNT_PASSWORD=
