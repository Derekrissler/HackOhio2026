# Copy this file to .env and fill it in.

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Canvas token from the instructor (or a TA/teacher account) on the test course.
# Carmen: Account > Settings > "+ New Access Token"
CANVAS_TOKEN=

# Carmen's Canvas host (carmen.osu.edu redirects here)
CANVAS_BASE_URL=https://osu.instructure.com
# Local dev against mock-canvas instead (any token works):
# CANVAS_BASE_URL=http://localhost:8001
# CANVAS_TOKEN=dev

# Free alternative to Claude: a local model through Ollama (no API key needed).
#   brew install ollama && brew services start ollama && ollama pull qwen2.5:3b
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:3b

# Optional: override the model
# CLAUDE_MODEL=claude-sonnet-5-5
