{
  "manifest_version": 3,
  "name": "Carmen Study Guide",
  "version": "0.1.0",
  "description": "Turns grader feedback on Canvas assignments into links to the course material you should review.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.instructure.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/courses/*/assignments/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
